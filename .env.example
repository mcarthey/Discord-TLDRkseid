# TLDRkseid Environment Configuration
# Copy this file to .env and fill in your values

# Required: Discord Bot Token
# Get this from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# Required: OpenAI API Key
# Get this from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Optional: Development Guild ID
# If set, slash commands register only to this guild (faster updates during dev)
# If not set, commands register globally (takes up to 1 hour to propagate)
DISCORD_DEV_GUILD_ID=
